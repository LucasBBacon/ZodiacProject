.header {
    font-size: 100px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    -unity-font: url("project://database/Assets/_Scripts/UI/MainMenu/MainMenuNew/Piccalilli-Regular.ttf?fileID=12800000&guid=40023d5f9124d374198c5249522fa2b0&type=3#Piccalilli-Regular");
    -unity-font-definition: initial;
}

.button {
    font-size: 20px;
    width: 220px;
    height: 60px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    justify-content: flex-start;
    align-items: auto;
    align-self: center;
    margin-top: 28px;
    margin-right: 28px;
    margin-bottom: 28px;
    margin-left: 28px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font: url("project://database/Assets/_Scripts/UI/MainMenu/MainMenuNew/Piccalilli-Regular.ttf?fileID=12800000&guid=40023d5f9124d374198c5249522fa2b0&type=3#Piccalilli-Regular");
    -unity-font-definition: initial;
}
